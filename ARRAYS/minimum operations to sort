class Solution {
    public int minOperations(int[] nums) {
       int n=nums.length;
       if(n==1)
       {
            return 0;
       }
        int start=0;
        while(nums[start]!=0)
        {
            start++;
        }
        if(start==n) {
            return -1;
        }
        boolean asc=true;
        boolean des=true;
        for(int i=1;i<n;i++) {
            int value=nums[(start+i)%n];
            if(value!=i) {
                asc=false;
            }
            if(value!=n-i) {
                des=false;
            }
            if(!asc && !des) {
                return -1;
            }
        }
            if(asc){
                return Math.min(start,n-start+2);
            }
        return Math.min(n-start,start+2);
    }
}
