class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        int min=nums[0];
        int max=nums[0];
        int n=nums.length;
        for(int i=0;i<n;i++) {
            if(nums[i]<min){
                min=nums[i];
            }
            if(nums[i]>max)
            {
                max=nums[i];
            }
        }
        List<Integer> ans=new ArrayList<>();
        for(int i=min+1;i<max;i++){
            boolean found=false;
            for(int j=0;j<n;j++) {
                if(nums[j]==i){
                    found=true;
                    break;
                }
            }
                if(found==false)
                {
                  ans.add(i);  
                }
            }
                return ans;
    }
}
