//optimal
class Solution {
    public List<Integer> targetIndices(int[] nums, int target) {
       int ltc=0;
       int tcnt=0;
       for(int num:nums) {
        if(num<target) {
            ltc++;
        }
        else if(num==target) {
            tcnt++;
        }
       } 
       List<Integer> res=new ArrayList<>();
       for(int i=0;i<tcnt;i++) {
        res.add(ltc+i);
       }
       return res;
    }
}
